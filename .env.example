DEBUG=false
USE_LOCAL_STORAGE=true

# SQLite
DATABASE_URL=sqlite:///./data/jobs.db

# Firebase (set USE_LOCAL_STORAGE=false and fill these to use Firebase)
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json
FIREBASE_STORAGE_BUCKET=digital-creators-9a4e0.firebasestorage.app

# Upload limits
MAX_VIDEOS_PER_JOB=50
MAX_FILE_SIZE_MB=100
MAX_TOTAL_SIZE_MB=500

# Hugging Face
CLIP_MODEL_ID=openai/clip-vit-base-patch32
MUSICGEN_MODEL_ID=facebook/musicgen-small
ENABLE_MUSICGEN=false
HF_CACHE_DIR=./data/hf_cache

# Transitions — styles rotate per clip boundary (comma-separated)
ENABLE_TRANSITIONS=true
TRANSITION_DURATION_SEC=0.5
TRANSITION_STYLES=fade,smoothleft,dissolve,wipeleft

# Default UI duration slider (seconds)
DEFAULT_OUTPUT_DURATION_SEC=15

# Server fallback encode profile when job omits quality_profile
VIDEO_QUALITY_PROFILE=fast

# Processing (defaults scale with CPU count if omitted; profile overrides preset/crf)
FFMPEG_PRESET=veryfast
FFMPEG_THREADS=4
PARALLEL_EXTRACT_WORKERS=4
PARALLEL_ANALYZE_WORKERS=6
JOB_TTL_HOURS=72
